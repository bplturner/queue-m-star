# M-Star Queue Manager — Configuration
# Generated by install.sh or edited manually.
# All paths should be absolute unless they are relative to the install directory.

# Paths for various files and directories
[paths]
log_file = "mstar_queue.log"                              # Path to the log file
queue_directory = "/opt/mstar_queue/queue/"                # Directory to watch for new MSB files (legacy intake)
mstar_executable = "/opt/mstar/mstar-cfd-mgpu-latest"     # Path to the default mstar-cfd-mgpu executable (fallback)
mstar_install_dir = "/opt/mstar"                           # Root directory containing all M-Star installations
database_file = "mstar_queue.db"                           # SQLite database file
jobs_directory = "jobs/"                                    # Directory for job working files
archive_directory = "archive"                              # Directory for completed/archived jobs
gpu_metrics_log = "gpu_metrics.log"                         # GPU metrics CSV log (1-second snapshots)
data_root = "/opt/mstar_queue/data"                        # Security boundary — file browser and copy-to restricted to this path

# Web server configuration
[web_server]
port = 1111                # Port for the web server to listen on
max_payload_size_mb = 500  # Maximum file upload size in MB for the web server

# File handling configuration
[file_handling]
max_file_size_mb = 500             # Maximum allowed size for MSB files in MB
allowed_file_types = ["msb"]       # Allowed file extensions

# GPU selection configuration
[gpu_selection]
reserved_gpu_max_utilization = 5.0             # Maximum utilization percentage for a reserved GPU to be considered free
reserved_gpu_max_memory_usage_percent = 10.0   # Maximum memory usage percentage for a reserved GPU to be considered free

# Job queue configuration
[queue]
max_concurrent_jobs = 8                # Maximum number of concurrent jobs
default_mstar_version = "latest"       # Default M-Star version (or specific e.g. "4.4.9")
job_output_retention_days = 90         # Days to retain job output (0 = forever)
poll_interval_secs = 5                 # Seconds between queue polling cycles
auto_requeue_on_restart = true         # Re-queue running jobs after reboot (vs marking failed)
startup_delay_secs = 10                # Wait for NFS/GPUs before processing queue after boot

# Security configuration
[security]
allowed_email_domain = ""              # Restrict registration to a domain (e.g. "mycompany.com"). Empty = allow all.