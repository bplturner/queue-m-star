#!/bin/bash
# pre-commit hook: Prevent AI training code and sensitive files from being
# committed to the PUBLIC repository.
#
# Install: This file should be at .git/hooks/pre-commit (auto-installed by setup)
# The hook blocks commits that contain:
#   1. Any files under python/ai_training/ (except the submodule pointer)
#   2. Sensitive files (credentials, databases, config with secrets)
#   3. Common secret patterns in staged file contents

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0

# -------------------------------------------------------
# 1. Block AI training files from being committed directly
#    (They should only exist as a submodule pointer)
# -------------------------------------------------------
AI_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^python/ai_training/' | grep -v '^python/ai_training$' || true)

if [ -n "${AI_FILES}" ]; then
    echo -e "${RED}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  BLOCKED: AI training files staged in PUBLIC repo!      ║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "The following AI training files would be committed to the PUBLIC repo:"
    echo "${AI_FILES}" | sed 's/^/  ✗ /'
    echo ""
    echo "AI training code must stay in the PRIVATE submodule."
    echo "To commit AI changes:"
    echo "  cd python/ai_training && git add -A && git commit && git push"
    echo "  cd ../.. && git add python/ai_training && git commit"
    echo ""
    echo "Or use: ./push-all.sh \"commit message\""
    ERRORS=$((ERRORS + 1))
fi

# -------------------------------------------------------
# 2. Block sensitive file types
# -------------------------------------------------------
SENSITIVE_PATTERNS=(
    '\.db$'
    '\.sqlite$'
    '\.mstar_credentials'
    'config\.toml$'
    'config_dev\.toml$'
    '\.env$'
    '\.env\.local$'
    '\.pem$'
    '\.key$'
    '\.p12$'
    '\.pfx$'
    'id_rsa'
    'id_ed25519'
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    MATCHES=$(echo "${STAGED_FILES}" | grep -E "${pattern}" || true)
    if [ -n "${MATCHES}" ]; then
        echo -e "${RED}BLOCKED: Sensitive file staged for commit:${NC}"
        echo "${MATCHES}" | sed 's/^/  ✗ /'
        ERRORS=$((ERRORS + 1))
    fi
done

# -------------------------------------------------------
# 3. Scan staged file contents for secret patterns
# -------------------------------------------------------
# Only scan text files, skip binaries
SECRET_PATTERNS=(
    'sk-[a-zA-Z0-9]{20,}'                    # OpenAI API keys
    'ghp_[a-zA-Z0-9]{36}'                    # GitHub personal access tokens
    'gho_[a-zA-Z0-9]{36}'                    # GitHub OAuth tokens
    'AKIA[0-9A-Z]{16}'                       # AWS access key IDs
    'AIza[0-9A-Za-z_-]{35}'                  # Google API keys
    '-----BEGIN (RSA |EC |DSA )?PRIVATE KEY'  # Private keys
    'password\s*=\s*"[^"]{8,}"'              # Hardcoded passwords in config
    'secret\s*=\s*"[^"]{8,}"'                # Hardcoded secrets in config
)

for file in ${STAGED_FILES}; do
    # Skip binary files and the pre-commit hook itself
    if [[ "${file}" == *.png ]] || [[ "${file}" == *.jpg ]] || [[ "${file}" == *.wasm ]] || \
       [[ "${file}" == *.db ]] || [[ "${file}" == *.pt ]] || [[ "${file}" == *.onnx ]] || \
       [[ "${file}" == *"pre-commit"* ]]; then
        continue
    fi

    # Get staged content (not working tree)
    CONTENT=$(git show ":${file}" 2>/dev/null || true)
    if [ -z "${CONTENT}" ]; then
        continue
    fi

    for pattern in "${SECRET_PATTERNS[@]}"; do
        if echo "${CONTENT}" | grep -qEi "${pattern}" 2>/dev/null; then
            echo -e "${YELLOW}WARNING: Potential secret in staged file: ${file}${NC}"
            echo "  Pattern matched: ${pattern}"
            # Don't block on warnings for code that handles auth (e.g., token extraction)
            # Only block on actual secret values
            if echo "${CONTENT}" | grep -qEi '(sk-|ghp_|gho_|AKIA|-----BEGIN)' 2>/dev/null; then
                echo -e "${RED}  BLOCKED: This looks like a real secret/key!${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done
done

# -------------------------------------------------------
# Result
# -------------------------------------------------------
if [ ${ERRORS} -gt 0 ]; then
    echo ""
    echo -e "${RED}Commit blocked: ${ERRORS} security issue(s) found.${NC}"
    echo "Use 'git commit --no-verify' to override (NOT recommended)."
    exit 1
fi

echo -e "${GREEN}✓ Pre-commit security checks passed${NC}"
exit 0
